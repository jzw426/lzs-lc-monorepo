{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resource Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceManifestVersion",
    "gameVersion",
    "contentVersion",
    "generatedBy",
    "resources"
  ],
  "properties": {
    "resourceManifestVersion": {
      "type": "string",
      "minLength": 1
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedBy": {
      "type": "string",
      "minLength": 1,
      "description": "Generator identifier; local machine timestamps are not included."
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "hash", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 digest as sha256: followed by 64 lowercase hexadecimal characters."
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
