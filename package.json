{
  "name": "lzs-lc-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm run build && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && pnpm -r --if-present test",
    "test:coverage": "pnpm run build && pnpm --filter @lzs/core test:coverage",
    "validate:content": "pnpm run build && pnpm --filter @lzs/tools validate:content",
    "replay:golden": "pnpm run build && pnpm --filter @lzs/tools replay:golden",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:coverage && pnpm run build && pnpm run validate:content && pnpm run replay:golden"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.18.8",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
